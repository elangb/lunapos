{
  "name": "lunapos",
  "private": true,
  "version": "1.0.0",
  "description": "LunaPOS - POS & Inventory (React + Express + MySQL)",
  "scripts": {
    "dev": "concurrently -n BACKEND,FRONTEND -c blue,green \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "db:init": "npm run db:init --prefix backend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install",
    "setup": "npm run setup --prefix backend",
    "setup:env": "npm run setup:env --prefix backend",
    "build": "npm run build --prefix frontend",
    "start": "node backend/src/index.js",
    "backup": "npm run backup --prefix backend",
    "restore": "npm run restore --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
